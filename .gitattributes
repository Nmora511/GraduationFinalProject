# Force all text files to use LF line endings in the repository
* text=auto eol=lf

# Ensure code scripts always use LF
*.cs text eol=lf
*.json text eol=lf

# Unity-specific files (must be treated as text with LF)
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf
*.prefab text eol=lf
*.mat text eol=lf

# Binary files (images, audio, models) should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.fbx binary
*.obj binary
*.wav binary
*.mp3 binary